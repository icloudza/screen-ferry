// screenferry-service.exe 的资源；清单不请求 UIAccess，权限由 SCM 提供。
// 由 crates/ferry-service/build.rs 编译：它按 Cargo.toml 的版本号生成 version.h（VERSION_MAJOR 等），
// 并把本文件所在的目录加进搜索路径，下面的文件路径都相对于这个目录。
#pragma code_page(65001)
#include "version.h"

// 图标：资源管理器、任务管理器、开始菜单里显示的就是它（编号最小的图标）。
1 ICON "../../assets/icons/app-icon-windows.ico"

// 程序清单（RT_MANIFEST = 24，编号 1 表示可执行文件自己的清单）。清单里没有注释，这里说明：
// - Common-Controls 6.0：托盘菜单等系统控件用新版外观。
// - asInvoker：以启动它的用户的权限运行，不请求管理员。uiAccess 能让程序操作以管理员身份运行的窗口，
//   但要求程序经过代码签名并装在 Program Files 里；本项目不签名，所以关着（见 ADR 0011）。
// - PerMonitorV2：按每台显示器的缩放比例工作，坐标都是物理像素，跨屏时不被系统缩放。
// - longPathAware：收发文件时允许超过 260 个字符的路径（还需要系统开启长路径支持）。
// - supportedOS：Windows 10 和 11（同一个标识）。
1 24 "app.manifest"

// 版本信息。常量取自 winver.h：VS_FFI_FILEFLAGSMASK、VOS_NT_WINDOWS32、VFT_APP。
1 VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 简体中文、Unicode。
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "icloudza"
            VALUE "FileDescription", "ScreenFerry Secure Input"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "screenferry-service"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "OriginalFilename", "screenferry-service.exe"
            VALUE "ProductName", "ScreenFerry"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
